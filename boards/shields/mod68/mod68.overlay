#include "mod68.dtsi"

/ {
    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-matrix";
                diode-direction = "row2col";
        wakeup-source;

        col-gpios
            = <&gpio 0  6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio 0  8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio 0 17 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio 0 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio 0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio 0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio 1  0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio 0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio 1  4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio 1  6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio 1  1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio 1  2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio 0  9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio 0 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio 1 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;

        row-gpios
            = <&gpio 1 13 GPIO_ACTIVE_HIGH>
            , <&gpio 1 15 GPIO_ACTIVE_HIGH>
            , <&gpio 0  2 GPIO_ACTIVE_HIGH>
            , <&gpio 0 29 GPIO_ACTIVE_HIGH>
            , <&gpio 0 31 GPIO_ACTIVE_HIGH>
            ;
    };
};

&physical_layout_mod68 {
    kscan = <&kscan0>;
};

