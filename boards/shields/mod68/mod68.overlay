#include "mod68.dtsi"

/ {
    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        /* row2col => le colonne sono INGRESSI (pull-down), le righe sono USCITE */
        col-gpios
            = <&gpio0  6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* D1  / TX  */
            , <&gpio0  8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* D0  / RX  */
            , <&gpio0 17 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* D2        */
            , <&gpio0 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* D3        */
            , <&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* D4        */
            , <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* D5        */
            , <&gpio1  0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* D6        */
            , <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* D7        */
            , <&gpio1  4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* D8        */
            , <&gpio1  6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* D9        */
            , <&gpio1  1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* pad extra P1.01 */
            , <&gpio1  2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* pad extra P1.02 */
            , <&gpio0  9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* D10 (NFC1) */
            , <&gpio0 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* D16 (NFC2) */
            , <&gpio1 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* D14       */
            ;

        row-gpios
            = <&gpio1 13 GPIO_ACTIVE_HIGH>                      /* D15       */
            , <&gpio1 15 GPIO_ACTIVE_HIGH>                      /* D18 / A0  */
            , <&gpio0  2 GPIO_ACTIVE_HIGH>                      /* D19 / A1  */
            , <&gpio0 29 GPIO_ACTIVE_HIGH>                      /* D20 / A2  */
            , <&gpio0 31 GPIO_ACTIVE_HIGH>                      /* D21 / A3  */
            ;
    };
};

&physical_layout_mod68 {
    kscan = <&kscan0>;
};
