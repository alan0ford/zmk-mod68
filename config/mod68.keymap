#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp ESC         &kp N1        &kp N2        &kp N3  &kp N4  &kp N5     &kp N6  &kp N7  &kp N8     &kp N9         &kp N0         &kp MINUS         &kp EQUAL          &kp BACKSPACE   &kp HOME
&kp TAB         &kp Q         &kp W         &kp E   &kp R   &kp T      &kp Y   &kp U   &kp I      &kp O          &kp P          &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BACKSLASH   &kp DEL
&kp CAPSLOCK    &kp A         &kp S         &kp D   &kp F   &kp G      &kp H   &kp J   &kp K      &kp L          &kp SEMICOLON  &kp SINGLE_QUOTE                     &kp ENTER       &kp PG_UP
&kp LEFT_SHIFT  &kp Z         &kp X         &kp C   &kp V   &kp B      &kp N   &kp M   &kp COMMA  &kp PERIOD     &kp SLASH      &kp RIGHT_SHIFT                      &kp UP          &kp PAGE_DOWN
&kp LCTRL       &kp LEFT_WIN  &kp LEFT_ALT                  &kp SPACE                  &mo 1      &kp RIGHT_ALT  &kp RCTRL      &kp LEFT_ARROW                       &kp DOWN_ARROW  &kp RIGHT
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans
&trans  &trans  &trans                  &trans                  &trans  &trans  &trans  &trans          &trans  &trans
            >;
        };
    };
};
